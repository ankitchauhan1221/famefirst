# Core
# connection_limit=1 queues SQLite writes. Remove it when you move to Postgres.
DATABASE_URL="file:./dev.db?connection_limit=1"
APP_URL="http://localhost:3000"
# Generate with: openssl rand -hex 32
JWT_SECRET=""
# Generate with: openssl rand -hex 32. Protects /api/cron/sync-orders
CRON_SECRET=""

# Branding and legal details shown on the site
NEXT_PUBLIC_SITE_NAME="FameFirst"
BUSINESS_NAME=""
SUPPORT_EMAIL=""

# SMM provider (Perfect Panel style API v2). Leave blank in development for the test provider.
PROVIDER_API_URL=""
PROVIDER_API_KEY=""

# Razorpay. Leave blank in development for instant test top-ups.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Google login (optional). Redirect URI: APP_URL/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Password reset email
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
